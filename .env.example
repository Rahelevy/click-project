# ============================================
# Google Cloud & AI Configuration
# ============================================

# Google API Key for GenAI (Optional - can use Vertex AI instead)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Service Account Credentials (Required)
# Path to your service account JSON file
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# ============================================
# BigQuery Cache Configuration
# ============================================

# BigQuery table for query result caching
# Format: project.dataset.table
BQ_CACHE_TABLE_ID=practicode-2025.cache.query_results

# Cache Time-To-Live in seconds
# Default: 2592000 (30 days)
BQ_CACHE_TTL_SECONDS=2592000

# Enable/disable caching
# Values: true, false, 1, 0, yes, no
BQ_CACHE_ENABLED=true

# ============================================
# Project Configuration
# ============================================

# Google Cloud Project ID
GCP_PROJECT_ID=practicode-2025

# BigQuery Dataset
BQ_DATASET=clicks_data_prac

# BigQuery Location
BQ_LOCATION=EU

# ============================================
# Application Settings
# ============================================

# ADK Application Name
ADK_APP_NAME=main_agent

# Log Level (debug, info, warning, error)
LOG_LEVEL=debug

# ============================================
# Development Settings
# ============================================

# Backend Server Port (ADK)
# Default: 8000
BACKEND_PORT=8000

# Frontend Development Server Port (Vite)
# Default: 5173
FRONTEND_PORT=5173

# ============================================
# Notes
# ============================================
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env to version control
# 3. The service account needs BigQuery access permissions
# 4. For local development, you can use GOOGLE_API_KEY
# 5. For production, use GOOGLE_APPLICATION_CREDENTIALS with Vertex AI
